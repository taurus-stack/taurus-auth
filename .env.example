# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=taurus_auth
DB_USER=root
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=3306

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379/1

# JWT Configuration
BACKEND_JWT_SECRET=your-jwt-secret-key-change-in-production
BACKEND_JWT_EXPIRES_MINUTES=60

# Security Configuration
ALLOWED_BACKEND_IPS=127.0.0.1,10.0.0.1,10.0.0.2
ALLOWED_BACKEND_SERVICES=taurus-backend

# Rate Limiting
RATELIMIT_ENABLE=True
RATELIMIT_RATE=100/m

# Macaroon Root Key
MACAROON_ROOT_KEY=your-macaroon-root-key-change-in-production

# Ticket Configuration
TICKET_DEFAULT_EXPIRES_MINUTES=5
TICKET_MAX_EXPIRES_MINUTES=60

# Django Configuration
SECRET_KEY=your-django-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=*
